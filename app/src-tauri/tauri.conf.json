{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "爱上喝水",
  "version": "0.3.0",
  "identifier": "com.waterreminder.pet",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "pet",
        "url": "pet/index.html",
        "title": "喝水搭子",
        "width": 240,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "visible": true
      },
      {
        "label": "main",
        "url": "main/index.html",
        "title": "喝水提醒",
        "width": 340,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": true
      },
      {
        "label": "settings",
        "url": "settings/index.html",
        "title": "设置",
        "width": 340,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": false
      },
      {
        "label": "stats",
        "url": "stats/index.html",
        "title": "喝水统计",
        "width": 340,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}